# Copia este archivo como .env y rellena los valores
# 1) Habla con @BotFather en Telegram -> /newbot -> copia el token
TELEGRAM_BOT_TOKEN=
# 2) Escribe a tu bot y abre https://api.telegram.org/bot<TOKEN>/getUpdates para ver tu chat_id
TELEGRAM_CHAT_ID=
# Minutos entre cada búsqueda automática
SCRAPE_INTERVAL_MIN=60
# Revisión de fotos en local y gratis (modelo CLIP, ~600 MB que se descargan la primera vez en data/models).
# PHOTO_REVIEW=off          # para desactivarla
# PHOTO_DAMAGE_THRESHOLD=0.35   # más bajo = más estricto (descarta más coches)
